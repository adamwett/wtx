# Commands that take no arguments, and arguments and flag values that take
# free text, suggest no files

# A command that takes no arguments
exec wtx __complete status ''
cmp stdout none.golden

# clone: a URL, then the name of the directory it creates
exec wtx __complete clone ''
cmp stdout none.golden
exec wtx __complete clone https://example.com/repo.git ''
cmp stdout none.golden

# init --name: a directory name under ~/.wtx
exec wtx __complete init --name ''
cmp stdout none.golden

# doctor --name: a directory name under ~/.wtx
exec wtx __complete doctor --migrate-home --name ''
cmp stdout none.golden

# wait --timeout: a duration
exec wtx __complete wait --timeout ''
cmp stdout none.golden

-- none.golden --
:4
